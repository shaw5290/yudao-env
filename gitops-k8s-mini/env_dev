# ================= gitops-k8s-mini 环境变量模板 =================
# 只用于本目录（服务器 K8s 最小 GitOps 环境），与根目录 .env.temp、gitops-k8s/.env.temp 分开维护
# 复制为同目录的 .env 后修改（.env、.env.local、.env.* 不提交），由 .env 生成命名空间 yudao-mini 的 Secret yudao-env，步骤见 README.md
# CHANGE_ME 必须替换；变量名一律用各镜像原生的环境变量名（清单中按同名取值，不做改名）
# 端口不在本文件：K8s 不支持变量替换，各工具的端口写在 base/services/<工具>.yaml 的 hostPort

# ================= PostgreSQL（postgres 镜像原生变量）=================
# 业务库名固定为 ruoyi-vue-pro（写在 base/services/postgresql.yaml），这里只配账号
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# ================= Redis =================
# 官方镜像没有密码环境变量，用通用名 REDIS_PASSWORD，经 --requirepass 传入
# 必须有这一行，缺少时 redis 报 CreateContainerConfigError；留空表示不设密码
REDIS_PASSWORD=

# ================= RabbitMQ（rabbitmq 镜像原生变量）=================
# 只在 rabbitmq-data 卷首次初始化时生效，之后修改需在管理控制台改密码或删除 PVC
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ================= r-nacos（r-nacos 原生变量）=================
# 控制台（10848）管理员账号，只在第一次启动（空库）时生效，之后在控制台改密码
RNACOS_INIT_ADMIN_USERNAME=admin
RNACOS_INIT_ADMIN_PASSWORD=7848bf1077803e8f618819083c6a74b9

# ================= Gitea（GITEA__<section>__<KEY> 原生格式）=================
# 【已停用】Git 仓库改用 Gitee，集群内不再部署 Gitea，以下变量保留备查
# 外部访问地址，末尾带 /；端口与 base/services/gitea.yaml 的 hostPort 一致
# GITEA__server__ROOT_URL=http://192.168.31.66:3000/
# 加密 2FA 密钥等，设置后不要再改；生成命令：openssl rand -hex 32
# GITEA__security__SECRET_KEY=39b67340c7b990d65fe5b82d0f40b77ecc21374d5fed4df25a855b3993697342

# ================= NORA（制品仓库原生变量，不开鉴权）=================
# 客户端看到的下载地址前缀（npm tarball 地址按它生成），写服务器 IP，端口与 base/services/nora.yaml 的 hostPort 一致
NORA_PUBLIC_URL=http://192.168.31.66:4000
# 上游代理与 gitops-k8s 相同，选择依据和检查方法见 ../gitops-k8s/README.md「NORA 上游加速地址」
# Maven、Docker：逗号分隔，按顺序回源；npm：只支持一个上游
NORA_MAVEN_PROXIES=https://maven.aliyun.com/repository/public,https://repo.huaweicloud.com/repository/maven,https://mirrors.cloud.tencent.com/nexus/repository/maven-public,https://repo1.maven.org/maven2
NORA_NPM_PROXY=https://registry.npmmirror.com
NORA_DOCKER_PROXIES=https://docker.m.daocloud.io,https://docker.1panel.live,https://registry-1.docker.io

# ================= GitOps 同步（gitops-sync 自定义变量）=================
# 【已停用】同步改用 Flux CD（clusters/<环境>/），Gitee、ACR 凭证不放在 yudao-env 中，见 README「Flux」
# 首次部署时留空：Gitea 建好仓库、生成 Token 后再填写并重建 Secret，见 README.md「启用 GitOps」
# 仓库地址用集群内 Service 名，例如 http://gitea:3000/<Gitea 用户>/yudao-env.git
# GITOPS_REPO_URL=
# 同步的分支，以及仓库内 kustomization.yaml 所在目录（相对仓库根）
# GITOPS_BRANCH=feature/dev
# GITOPS_PATH=gitops-k8s-mini
# Gitea 用户名和访问令牌（只需 repository 读权限）；公开仓库可留空
# GITOPS_GIT_USERNAME=
# GITOPS_GIT_TOKEN=
