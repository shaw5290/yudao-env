# ============================================================
#  yudao-cloud Docker 环境变量模板
#  使用方式：
#    1. 复制为 .env：  copy .env.temp .env
#    2. 按实际环境修改下方各项
#    3. .env 已在 .gitignore 中，不会提交
# ============================================================

# ================= 项目 =================
# 容器名前缀：未配置或留空时默认 yudao（toggle-yudao.bat 的 DB_CONTAINER=yudao-mysql 依赖它）
# 填 yudao = 容器名变成 yudao-nginx / yudao-mysql ...
PROJECT_NAME=yudao

# ================= 端口 =================
# 如与本机已有服务冲突，改这里即可
NGINX_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379

# Nacos 3.x：8848 客户端，8080 控制台（与 IDEA 内嵌 Nacos 二选一启动，控制台端口统一为 8080）
NACOS_PORT=8848
NACOS_CONSOLE_PORT=8080
NACOS_GRPC_PORT=9848
NACOS_GRPC_PORT_2=9849

JENKINS_PORT=8089
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_VIP_PORT=10909
# RabbitMQ：5672 AMQP，15672 管理控制台
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
XXL_JOB_PORT=9090
SEATA_PORT=8091
SEATA_DASHBOARD_PORT=7091
SENTINEL_PORT=8858
TDENGINE_PORT=6041
POSTGRES_PORT=5432

# Grafana LGTM：3000 Grafana 控制台，4317 / 4318 为 OTLP gRPC / HTTP 接收端口
LGTM_GRAFANA_PORT=3000
LGTM_OTLP_GRPC_PORT=4317
LGTM_OTLP_HTTP_PORT=4318

# ELK：9200 Elasticsearch，5044 Logstash 的 tcp 输入（应用上报日志），5601 Kibana 控制台
ELASTICSEARCH_PORT=9200
LOGSTASH_TCP_PORT=5044
KIBANA_PORT=5601

# NORA 制品仓库：Docker / Maven / npm / Web UI 共用一个端口
NORA_PORT=4000

# ================= MySQL =================
# 首次启动 initdb 时也会用这个密码
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ================= Redis =================
REDIS_PASSWORD=CHANGE_ME

# ================= Nacos 连接 MySQL =================
NACOS_DB_NAME=nacos
NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=CHANGE_ME

# ================= Nacos 鉴权 =================
# NACOS_AUTH_TOKEN 必须是 Base64 编码的 32 字节密钥
# 生成命令：openssl rand -base64 32
NACOS_AUTH_ENABLE=1
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_32_BYTES
NACOS_AUTH_IDENTITY_KEY=postal
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME

# ================= MinIO =================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# ================= RocketMQ =================
# broker 注册给客户端用的宿主机 IP，必填，不能写 127.0.0.1
# 查看本机 IP：ipconfig（Windows）/ ifconfig（Linux/Mac）
ROCKETMQ_BROKER_IP=CHANGE_ME_HOST_IP

# ================= RabbitMQ =================
# 管理员账号，变量名与 yudao-cloud 一致（spring.rabbitmq.username / password 读取同名环境变量）
# 只在 rabbitmq-data 卷首次初始化时生效，之后修改需在管理控制台改密码或清空数据卷
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=CHANGE_ME

# ================= NORA（制品仓库）=================
# 客户端看到的下载地址前缀（npm tarball 地址按它生成），改了 NORA_PORT 要同步；局域网其他机器访问时改成宿主机 IP
NORA_PUBLIC_URL=http://localhost:4000
# 上游代理：逗号分隔，按顺序回源；默认阿里云 + Maven Central、npmmirror、Docker Hub
NORA_MAVEN_PROXIES=https://maven.aliyun.com/repository/public,https://repo1.maven.org/maven2
NORA_NPM_PROXY=https://registry.npmmirror.com
NORA_DOCKER_PROXIES=https://registry-1.docker.io
# 鉴权：默认关闭（任何人可读写，只适合本机开发）
# 开启前先生成 nora/auth/users.htpasswd（bcrypt，不提交），在 cmd 中执行（PowerShell 的 > 会写成 UTF-16）：
#   docker run --rm httpd:2.4-alpine htpasswd -nbB <用户名> <密码> > nora\auth\users.htpasswd
# 开启后上传 / 推送必须带账号；下面两项控制 Maven/npm 下载、镜像拉取是否允许匿名
NORA_AUTH_ENABLED=false
NORA_AUTH_ANONYMOUS_READ=true
NORA_AUTH_DOCKER_ANON_PULL=true

# ================= XXL-Job =================
XXL_JOB_DB_NAME=xxl_job

# ================= Seata =================
# 同样填宿主机 IP
SEATA_IP=CHANGE_ME_HOST_IP

# ================= TDengine（IoT 模块用）=================
# 跟 nginx/mysql/redis/nacos 一样是核心服务，随核心一起启动
# 无需额外配置，TDENGINE_PORT 已在上面的端口区设置

# ================= PostgreSQL（可选中间件）=================
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# TDengine 默认账号密码(镜像不支持通过环境变量修改，固定为 root/taosdata)
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=taosdata
