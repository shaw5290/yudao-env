# ============================================================
#  yudao-cloud Docker 环境变量模板
#  使用方式：
#    1. 复制为 .env：  copy .env.temp .env
#    2. 按实际环境修改下方各项
#    3. .env 已在 .gitignore 中，不会提交
# ============================================================

# ================= 项目 =================
# 容器名前缀：留空 = 容器名就是服务名（nginx/mysql/redis/nacos...）
# 填 yudao = 容器名变成 yudao-nginx / yudao-mysql ...
PROJECT_NAME=yudao

# ================= 端口 =================
# 如与本机已有服务冲突，改这里即可
NGINX_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379

# Nacos 3.x：8848 客户端，8080 控制台（映射到宿主机 8081，避开 Jenkins 8080）
NACOS_PORT=8848
NACOS_CONSOLE_PORT=8081
NACOS_GRPC_PORT=9848
NACOS_GRPC_PORT_2=9849

JENKINS_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_VIP_PORT=10909
XXL_JOB_PORT=8088
SEATA_PORT=8091
SEATA_DASHBOARD_PORT=7091
SENTINEL_PORT=8858

# ================= MySQL =================
# 首次启动 initdb 时也会用这个密码
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ================= Redis =================
REDIS_PASSWORD=CHANGE_ME

# ================= Nacos 连接 MySQL =================
NACOS_DB_NAME=nacos
NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=CHANGE_ME

# ================= Nacos 鉴权 =================
# NACOS_AUTH_TOKEN 必须是 Base64 编码的 32 字节密钥
# 生成命令：openssl rand -base64 32
NACOS_AUTH_ENABLE=1
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_32_BYTES
NACOS_AUTH_IDENTITY_KEY=postal
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME

# ================= MinIO =================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# ================= RocketMQ =================
# broker 注册给客户端用的宿主机 IP，必填，不能写 127.0.0.1
# 查看本机 IP：ipconfig（Windows）/ ifconfig（Linux/Mac）
ROCKETMQ_BROKER_IP=CHANGE_ME_HOST_IP

# ================= XXL-Job =================
XXL_JOB_DB_NAME=xxl_job

# ================= Seata =================
# 同样填宿主机 IP
SEATA_IP=CHANGE_ME_HOST_IP