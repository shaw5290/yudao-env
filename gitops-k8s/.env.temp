# ================= gitops-k8s 环境变量模板 =================
# 只用于本目录（服务器 K8s 部署），与根目录 .env.temp（本机 compose / k8s 菜单）分开维护
# 复制为同目录的 .env 后修改（.env 不提交），由 .env 生成 Secret yudao-env，步骤见 README.md
# 只包含本目录 7 个服务用到的变量；CHANGE_ME 必须替换，后端 yudao-cloud 连接服务器时使用同样的账号密码
# 变量名一律用各镜像原生的环境变量名（清单中按同名取值，不做改名）；镜像没有原生变量的（redis 密码）用通用名
# 端口不在本文件：K8s 不支持变量替换，各工具的端口写在 services/<工具>.yaml 的 hostPort，与该工具的其他配置在一起

# ================= PostgreSQL（postgres 镜像原生变量）=================
# 业务库名固定为 ruoyi-vue-pro（写在 services/postgres.yaml），这里只配账号
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ================= Redis =================
# 官方镜像没有密码环境变量，用通用名 REDIS_PASSWORD（bitnami 镜像、Spring 配置同名），经 --requirepass 传入
# 必须有这一行，缺少时 redis 报 CreateContainerConfigError；留空表示不设密码
REDIS_PASSWORD=CHANGE_ME

# ================= Nacos 鉴权（nacos-server 镜像原生变量）=================
# 内置存储（Derby），不连接 MySQL，所以没有 NACOS_DB_* 变量
# 下面三个值任一为空 Nacos 会直接退出；NACOS_AUTH_TOKEN 必须是 Base64 编码的 32 字节密钥
# 生成命令：openssl rand -base64 32
NACOS_AUTH_ENABLE=true
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_32_BYTES
NACOS_AUTH_IDENTITY_KEY=yudao
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME

# ================= RabbitMQ（rabbitmq 镜像原生变量）=================
# 只在 rabbitmq-data 卷首次初始化时生效，之后修改需在管理控制台改密码或删除 PVC
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ================= MinIO（minio 镜像原生变量）=================
# MINIO_ROOT_PASSWORD 至少 8 位
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# ================= NORA（制品仓库原生变量，不开鉴权）=================
# 客户端看到的下载地址前缀（npm tarball 地址按它生成），写服务器 IP，端口与 services/nora.yaml 的 hostPort 一致
NORA_PUBLIC_URL=http://CHANGE_ME_HOST_IP:4000
# 上游代理：逗号分隔，按顺序回源
NORA_MAVEN_PROXIES=https://maven.aliyun.com/repository/public,https://repo1.maven.org/maven2
NORA_NPM_PROXY=https://registry.npmmirror.com
NORA_DOCKER_PROXIES=https://registry-1.docker.io
