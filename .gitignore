# ============================================================
#  原则：运行时数据/日志/缓存 忽略；通用配置/初始化脚本 保留
# ============================================================

# ===== 通用日志 =====
logs/
data/
*.log

# ===== config/：compose 与 k8s 共用的挂载文件，只提交配置/初始化脚本 =====
# MySQL：保留 conf、initdb
config/mysql/**
!config/mysql/conf/
!config/mysql/conf/**
!config/mysql/initdb/
!config/mysql/initdb/**
# RocketMQ：保留 broker.conf（目前不入库，启用 rocketmq 前自行创建）
config/rocketmq/namesrv/logs/
config/rocketmq/broker/logs/
config/rocketmq/broker/store/
# Seata：忽略日志，保留 resources
config/seata/logs/
# NORA：htpasswd 含账号口令，不提交，只保留目录
config/nora/auth/*
!config/nora/auth/.gitkeep

# ===== k8s：单服务部署时脚本生成的临时方案 =====
k8s/.render/

# ===== Jenkins：整个 jenkins_home 都是运行时数据 =====
jenkins/jenkins_home/

# ===== Docker Compose 本地覆盖/环境变量 =====
docker-compose.override.yml
compose/**/docker-compose.override.yml
.env
.env.local
.env.*
!.env.temp
# gitops-k8s 早期使用的口令文件名（现在统一用 .env）
gitops-k8s/*.env

# ===== 批处理脚本（本机用，按需放开）=====
# compose/yudao.bat
# k8s/yudao-k8s.bat

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编译产物 / 依赖 =====
target/
build/
dist/
node_modules/
*.class
*.jar
