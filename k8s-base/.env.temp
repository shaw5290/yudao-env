# ================= k8s-base 环境变量模板 =================
# 复制为同目录的 .env 后修改（.env 不提交），由 .env 生成命名空间 yudao-local 的 Secret yudao-env，步骤见 README.md
# 变量名一律用镜像原生的环境变量名（清单中按同名取值，不做改名）；CHANGE_ME 必须替换
# 端口不在这里：K8s 不支持变量替换，端口写在 services/<服务>.yaml 的 hostPort
# 本文件由 gitops-k8s-mini/env_local 精简而来，只保留当前实际部署的基础组件（postgresql、gitea、nora、act-runner）

# ================= PostgreSQL（postgres 镜像原生变量）=================
# 空库首次初始化时按这三个变量建库建用户，之后修改需进库改，删 PVC 才会重新初始化
POSTGRES_DB=gitea
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ================= Gitea（GITEA__<section>__<KEY> 原生格式）=================
# 外部访问地址，末尾带 /；端口与 services/gitea.yaml 的 hostPort 一致
# 换网换 IP 后必须更新：ops/gitea-root-url.sh 会自动改成当前局域网 IP
GITEA__server__ROOT_URL=http://CHANGE_ME_HOST_IP:3000/
# 加密 2FA、Actions 密钥等，设置后不要再改；生成命令：openssl rand -hex 32
GITEA__security__SECRET_KEY=CHANGE_ME

# ================= NORA（制品仓库：Docker / Maven / npm）=================
# 镜像名里的地址固定 10.10.10.10:4000（dummy0），不随路由器变；这里只配客户端看到的下载地址与上游代理
# 换网换 IP 后 NORA_PUBLIC_URL 需与 GITEA__server__ROOT_URL 一起更新
NORA_PUBLIC_URL=http://CHANGE_ME_HOST_IP:4000
NORA_MAVEN_PROXIES=https://maven.aliyun.com/repository/public,https://repo.huaweicloud.com/repository/maven,https://mirrors.cloud.tencent.com/nexus/repository/maven-public,https://repo1.maven.org/maven2
NORA_NPM_PROXY=https://registry.npmmirror.com
# NORA 1.4.4 在 push 的 manifest HEAD 阶段会查上游；留两个能快速返回 403 的镜像源即可，
# 不要放 registry-1.docker.io（本机超时 30s，会让推送卡死）。基础镜像实际由 dind 的 registry-mirror 拉取
NORA_DOCKER_PROXIES=https://docker.m.daocloud.io,https://docker.1panel.live
